{
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "base_url_env": "OPENAI_BASE_URL",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-4o-mini",
    "temperature": 0.2,
    "max_tokens": 4096,
    "timeout": 120,
    "providers": {
      "openai": {
        "base_url": "https://api.openai.com/v1",
        "api_key_env": "OPENAI_API_KEY",
        "model": "gpt-4o-mini"
      },
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-v4-flash",
      "supports_tool_choice": false
      },
      "key77": {
        "base_url": "https://api.key77qiqi.com/v1",
        "api_key_env": "KEY77_API_KEY",
        "model": "gpt-4o-mini"
      },
      "minimax": {
        "base_url": "https://api.minimaxi.com/v1",
        "api_key_env": "MINIMAX_API_KEY",
        "model": "MiniMax-M1"
      }
    }
  },
  "explorer": {
    "workflow_version": "v5",
    "max_steps": 30,
    "max_runtime_seconds": 900,
    "response_retries": 2,
    "truncation_retries": 1,
    "truncation_retry_max_tokens": 8192,
    "deepseek_disable_thinking_on_truncation": true,
    "finalization_steps": 3,
    "fault_skill_attempt_step": 4,
    "finalization_max_tokens": 8192,
    "system_prompt_path": "prompt_records/explorer/explorer_system_v5.txt",
    "fault_skill_selector_prompt_path": "prompt_records/explorer/fault_skill_selector_v1.txt",
    "fault_skill_validator_prompt_path": "prompt_records/explorer/fault_skill_validator_v1.txt",
    "fault_skill_selector_max_tokens": 4096,
    "fault_skill_selector_retry_max_tokens": 8192,
    "fault_skill_selector_attempts": 3
  },
  "reflection": {
    "investigator_prompt_path": "prompt_records/reflection/investigator_v5.txt",
    "fault_reflector_prompt_path": "prompt_records/reflection/fault_reflector_v5.txt",
    "investigation_tool_budget": 16,
    "investigation_response_attempts": 2,
    "investigation_conclusion_max_tokens": 8192,
    "investigation_timeout_seconds": 900,
    "evolution_query_prompt_path": "prompt_records/reflection/evolution_query_v5.txt",
    "fault_target_selector_prompt_path": "prompt_records/reflection/fault_skill_target_selector_v1.txt",
    "fault_target_selector_attempts": 2,
    "query_attempts": 2,
    "reflector_attempts": 2,
    "reflector_max_tokens": 8192,
    "reflector_truncation_retries": 1,
    "reflector_truncation_retry_max_tokens": 8192,
    "deepseek_disable_thinking_on_reflector_truncation": true,
    "reflector_candidate_top_k": 5
  },
  "skill_bank": {
    "path": "skill_pools/fault_skill_bank/skills.jsonl",
    "enabled_skill_types": ["fault_skill"],
    "retrieval_mode": "lexical",
    "max_matched_skills": 2,
    "min_score": 4.0,
    "project_skill_min_score": 6.0,
    "embedding_min_score": 0.48,
    "project_skill_candidate_min_score": 0.0,
    "embedding_fallback_to_lexical": false,
    "max_per_skill_type": {
      "project_skill": 1,
      "fault_skill": 1,
      "strategy_skill": 1
    }
  },
  "embedding": {
    "enabled": false,
    "base_url": "http://127.0.0.1:8008",
    "base_url_env": "EVOLUTEFL_EMBEDDING_BASE_URL",
    "endpoint": "/embed",
    "model": "jina-embeddings-v3",
    "query_task": "retrieval.query",
    "document_task": "retrieval.passage",
    "cache_path": "skill_pools/fault_skill_bank/embeddings/jina_v3/skill_embeddings.jsonl",
    "batch_size": 16,
    "timeout": 120
  }
}
